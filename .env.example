# =====================================================================
# InternMatch AI — environment template.  Copy to `.env` and edit.
# =====================================================================

# ---------- Flask ----------
FLASK_CONFIG=default            # default | dev | prod
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-too-super-secret
JWT_EXPIRES_HOURS=12
PORT=8000
FLASK_DEBUG=0

# ---------- MySQL (primary target) ----------
# Either set MYSQL_* (a URI is built for you) …
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=internmatch
# … or provide a full SQLAlchemy URI (takes priority):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/internmatch?charset=utf8mb4

# Leave all of the above unset to run on the zero-config SQLite fallback
# (instance/internmatch.db) — useful for quick demos and CI.

# ---------- MySQL TLS (managed hosts: Aiven, TiDB Cloud, …) ----------
# PyMySQL 2.x already tries TLS and falls back to plaintext when the server has
# no TLS, which satisfies providers that merely *require* an encrypted
# connection. Tighten it with:
#   MYSQL_SSL_MODE=verify-ca         require TLS + verify the server certificate
#   MYSQL_SSL_MODE=verify-identity   as above, plus host-name verification
#   MYSQL_SSL_MODE=disabled          never use TLS (local socket / trusted VPN)
# verify-* modes need the provider's CA bundle:
#   MYSQL_SSL_MODE=verify-ca
#   MYSQL_SSL_CA=/etc/ssl/certs/aiven-ca.pem

# ---------- Deployment (Render) ----------
# On a host, PORT is set by the platform (don't hard-code 8000 there).
# SECRET_KEY / JWT_SECRET must be long random strings in production.
# NLTK_DATA points at the corpora directory created by build.sh.

# ---------- Trust engine ----------
# 1 = query real WHOIS + DNS MX records (needs internet; slower first call)
# 0 = deterministic synthetic domain registry (offline-safe demo default)
ENABLE_LIVE_DOMAIN_CHECKS=0

# ---------- Admin self-registration ----------
ADMIN_INVITE_CODE=INTERNMATCH-ADMIN
